{
  "context7": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@upstash/context7-mcp@latest"
    ],
    "env": {}
  },
  "Playwright": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@playwright/mcp@latest"
    ],
    "env": {}
  },
  "fetch": {
    "command": "uvx",
    "args": [
      "mcp-server-fetch"
    ]
  },
  "seatable": {
    "type": "stdio",
    "command": "uvx",
    "args": [
      "--from",
      "git+https://github.com/ppx123-web/seatable.git",
      "seatable-mcp"
    ],
    "env": {
      "SEATABLE_CONFIG_PATH": "***MASKED PATH***"
    }
  },
  "zai-mcp-server": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@z_ai/mcp-server"
    ],
    "env": {
      "Z_AI_API_KEY": "***MASKED***",
      "Z_AI_MODE": "ZHIPU"
    }
  },
  "web-search-prime": {
    "type": "http",
    "url": "https://open.bigmodel.cn/api/mcp/web_search_prime/mcp",
    "headers": {
      "Authorization": "Bearer ***MASKED***"
    }
  },
  "web-reader": {
    "type": "http",
    "url": "https://open.bigmodel.cn/api/mcp/web_reader/mcp",
    "headers": {
      "Authorization": "Bearer ***MASKED***"
    }
  },
  "zread": {
    "type": "http",
    "url": "https://open.bigmodel.cn/api/mcp/zread/mcp",
    "headers": {
      "Authorization": "Bearer ***MASKED***"
    }
  }
}
